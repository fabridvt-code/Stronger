rules_version = '2';

// Stronger — Firestore security rules (spec §5).
// Every synced document lives under users/{uid}/documents/{id}. A signed-in user
// can read and write only their own subtree; nobody can touch anyone else's data.
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid}/documents/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
