# ---------------------------------------------------------------------------
# AI import engine (server-side only — keys are never exposed to the client).
# Default engine is Gemini. Without a key, text/PDF-with-text import still works
# via the deterministic parser; only photos / scanned PDFs need an AI key.
# ---------------------------------------------------------------------------

# Google Gemini (default). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model override (e.g. gemini-2.5-flash, gemini-2.5-pro, gemini-2.0-flash)
GEMINI_MODEL=gemini-2.5-flash

# Force a provider explicitly: "gemini" (default) or "anthropic".
# AI_PROVIDER=gemini

# Alternative engine — Anthropic Claude (optional).
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-sonnet-5

# ---------------------------------------------------------------------------
# Firebase cloud sync + auth (optional; app is fully local without these).
# From Firebase console → Project settings → Your apps → Web app config.
# These are public by design (security is enforced by Firestore rules).
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR-PROJECT.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=YOUR-PROJECT
# NEXT_PUBLIC_FIREBASE_APP_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=YOUR-PROJECT.appspot.com
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
